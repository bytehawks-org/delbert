# /etc/delbert/proxy.env (mode 0640 root:delbert-proxy). Used by delbert-proxy.service; docs/PROXY.md.
# The site's NATS server (authorization callout towards this proxy).
DELBERT_LOCAL_NATS_URL=tls://127.0.0.1:4222
DELBERT_LOCAL_AUTH_PASSWORD=
# How the agents of the site reach that NATS server.
DELBERT_PUBLIC_NATS_URL=tls://proxy.example.com:4222
DELBERT_LISTEN=0.0.0.0:8443
RUST_LOG=info
