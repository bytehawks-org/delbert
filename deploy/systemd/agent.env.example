# /etc/delbert/agent.env (mode 0600). Used by delbert-agent.service.
DELBERT_CORE_URL=https://delbert.example.com:8443
DELBERT_CA_FILE=/etc/delbert/ca.pem
# One-time enrollment key from the Core (POST /v1/tenants/<tenant>/enrollment-keys). It is only
# needed for the first start; remove it afterwards.
DELBERT_ENROLL_PSK=
DELBERT_AGENT_ID=web-01
DELBERT_INTERVAL_SECS=300
RUST_LOG=info
