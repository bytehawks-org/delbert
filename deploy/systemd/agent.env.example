# /etc/delbert/agent.env (mode 0600). Used by delbert-agent.service.
DELBERT_CORE_URL=https://delbert.example.com:8443
DELBERT_CA_FILE=/etc/delbert/ca.pem
# One-time enrollment key from the Core (POST /v1/tenants/<tenant>/enrollment-keys). It is only
# needed for the first start; remove it afterwards.
DELBERT_ENROLL_PSK=
DELBERT_AGENT_ID=web-01
DELBERT_INTERVAL_SECS=300
# Executables that `cron` resources may schedule (absolute paths, ':' separated). Empty: every
# cron resource is refused (docs/POLICY.md "Scheduled jobs"). Only this file can change it.
DELBERT_CRON_ALLOW=
# Executables that `command` resources and their guards may run (absolute paths, ':' separated,
# optionally pinned as path@sha256). Empty: every command is refused (docs/POLICY.md "Commands").
# List programs and scripts, never an interpreter such as /bin/sh.
DELBERT_COMMAND_ALLOW=
RUST_LOG=info
