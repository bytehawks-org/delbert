# /etc/delbert/core.env (mode 0640 root:delbert). Secrets of delbert-core.service; everything
# else is in /etc/delbert/core.toml. docs/install.md "Linux packages".
# Runtime role (cannot rewrite the audit trail) and schema owner (migrations at start).
DATABASE_URL=postgres://delbert_rt:CHANGE@127.0.0.1:5432/delbert
DATABASE_MIGRATE_URL=postgres://delbert:CHANGE@127.0.0.1:5432/delbert
# The static user of the NATS authorization callout (same password as in the NATS configuration).
NATS_AUTH_USER=auth
NATS_AUTH_PASSWORD=CHANGE
# Only for the first start (12+ characters): creates the user "admin". Remove it afterwards.
DELBERT_BOOTSTRAP_ADMIN_PASSWORD=
RUST_LOG=info
